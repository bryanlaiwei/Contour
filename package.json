{
  "name": "automatic-project-map",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @apm/web",
    "dev:api": "npm run dev --workspace @apm/api",
    "dev:worker": "npm run dev --workspace @apm/worker",
    "dev:helper": "npm run start --workspace @apm/local-collector -- serve",
    "build": "npm run build:server",
    "build:server": "npm run build --workspace @apm/shared && npm run build --workspace @apm/github-collector && npm run build --workspace @apm/core && npm run build --workspace @apm/api && npm run build --workspace @apm/worker",
    "start": "node scripts/start-hosted.mjs",
    "start:hosted": "node scripts/start-hosted.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
